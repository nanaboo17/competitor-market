{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "competitor-market",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
